{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@gtstore/contracts/*": ["packages/contracts/src/*"],
      "@gtstore/domain/*": ["packages/domain/src/*"],
      "@gtstore/ui/*": ["packages/ui/src/*"],
      "@gtstore/adapters/*": ["packages/adapters/src/*"]
    }
  },
  "include": [
    "packages/**/*.ts",
    "packages/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "apps/admin",
    "apps/api",
    "apps/storefront"
  ]
}
