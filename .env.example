PORT=3000
HOST=0.0.0.0
# Публичный HTTPS-адрес без завершающего слеша. Обязателен для Telegram Mini App и webhook.
# Без https:// Telegram не откроет WebApp-кнопку.
PUBLIC_BASE_URL=https://store.example.com
# Случайная длинная строка. После смены ключа старые сохранённые токены нельзя расшифровать.
GTSTORE_TOKEN_SECRET=replace-with-at-least-32-random-characters
# V6 API
V6_PORT=4000
# Пример Mini App URL для v6: https://store.example.com/app/?shop=demo-store
