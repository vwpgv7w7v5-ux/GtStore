# Copy the EXISTING production encryption/session secrets when migrating.
# Never commit the populated /etc/gtstore/gtstore.env file to GitHub.
HOST=127.0.0.1
V6_PORT=4000
V6_DATABASE_FILE=/var/lib/gtstore/v6.json
V6_MEDIA_DIRECTORY=/var/lib/gtstore/media
PUBLIC_BASE_URL=https://72-56-28-133.sslip.io
# Set these securely before starting; preserve their existing values on migration.
GTSTORE_TOKEN_SECRET=REPLACE_WITH_EXISTING_OR_NEW_RANDOM_SECRET
GTSTORE_CUSTOMER_SESSION_SECRET=REPLACE_WITH_EXISTING_OR_NEW_RANDOM_SECRET
GTSTORE_PAYMENT_WEBHOOK_SECRET=REPLACE_WITH_EXISTING_OR_NEW_RANDOM_SECRET
GTSTORE_SCHEDULER_SECRET=REPLACE_WITH_EXISTING_OR_NEW_RANDOM_SECRET
